{
  "name": "cgraph",
  "version": "0.3.0",
  "description": "Local-first code graph CLI for GHCP agent efficiency",
  "bin": {
    "cgraph": "./bin/cgraph.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node bin/cgraph.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:performance": "node ./scripts/check-performance-budget.mjs",
    "benchmark:a2a": "node ./scripts/benchmark-a2a-multihop.mjs",
    "benchmark:a2a:baseline": "node ./scripts/benchmark-a2a-multihop.mjs 25 --save reports/a2a-baseline.json",
    "benchmark:a2a:compare": "node ./scripts/benchmark-a2a-multihop.mjs 25 --compare reports/a2a-baseline.json --save reports/a2a-current.json",
    "benchmark:a2a:gate": "node ./scripts/benchmark-a2a-multihop.mjs 25 --compare reports/a2a-baseline.json --save reports/a2a-current.json --budget fixtures/a2a-benchmark-budget.json --enforce",
    "benchmark:a2a:gate:local": "node ./scripts/benchmark-a2a-multihop.mjs 15 --compare reports/a2a-baseline.json --save reports/a2a-current.json --budget fixtures/a2a-benchmark-budget.local.json --enforce",
    "benchmark:memory": "node ./scripts/benchmark-memory.mjs",
    "benchmark:memory:soak": "node ./scripts/benchmark-memory-soak.mjs",
    "check:memory": "node ./scripts/check-memory-budget.mjs",
    "verify": "npm run build && npm run test:coverage && npm run check:performance && npm run check:memory"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.29.7",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "commander": "^12.0.0",
    "fast-glob": "^3.3.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^20.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "codegraph",
    "code-analysis",
    "ghcp",
    "copilot",
    "agent"
  ],
  "license": "AGPL-3.0"
}
