{
  "name": "cgraph",
  "version": "0.1.0",
  "description": "Local-first code graph CLI for GHCP agent efficiency",
  "bin": {
    "cgraph": "./bin/cgraph.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node bin/cgraph.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
